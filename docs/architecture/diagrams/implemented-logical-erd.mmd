    SOURCE_DOCUMENT ||--o{ COUNTRY_TAG_DECLARATION : contains
    STATE_ENTITY ||--|{ STATE_DECLARATION : contributions
    COUNTRY_ENTITY ||--|{ COUNTRY_TAG_DECLARATION : contributions
    STATE_ENTITY ||--o{ STATE_RESOURCE : has
