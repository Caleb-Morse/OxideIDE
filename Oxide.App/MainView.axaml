<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Oxide.App.ViewModels"
        xmlns:navigation="using:Oxide.Core.Workspaces.Navigation"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Oxide.App.MainView" x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800" MinWidth="980" MinHeight="640"
        KeyDown="SourceViewer_KeyDown"
        Background="{DynamicResource OxideBackground}" Foreground="{DynamicResource OxideText}">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource OxideAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource OxideOnAccent}" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="{DynamicResource OxideSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource OxideText}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource OxideSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OxideBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource OxideText}" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource OxideSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OxideBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource OxideMuted}" /></Style>
        <Style Selector="TextBlock.attention"><Setter Property="Foreground" Value="{DynamicResource OxideErrorText}" /></Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource OxideMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="TabControl"><Setter Property="Background" Value="Transparent" /></Style>
    </Window.Styles>

    <Grid RowDefinitions="60,*,34">
        <Border Grid.Row="0" Background="{DynamicResource OxideSurface}" BorderBrush="{DynamicResource OxideBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0" ColumnDefinitions="Auto,18,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource OxideAccent}">
                        <TextBlock Text="O" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="18" Foreground="{DynamicResource OxideOnAccent}" />
                    </Border>
                    <TextBlock Text="Oxide" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding IsWorkspaceVisible}">
                    <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WorkspaceSummary}" Classes="muted" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Button Classes="quiet" Content="⚙  Settings">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Width="310" Padding="8">
                                    <StackPanel Spacing="18">
                                        <StackPanel Spacing="7" IsVisible="{Binding IsWorkspaceVisible}">
                                            <TextBlock Text="Localisation language" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                                      SelectedItem="{Binding SelectedLanguageOption, Mode=OneWay}"
                                                      DisplayMemberBinding="{Binding DisplayName}"
                                                      IsEnabled="{Binding HasAvailableLanguages}"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="Language_SelectionChanged" />
                                            <TextBlock Text="Choose which in-game translated names Oxide displays."
                                                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Dark mode" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkMode, Mode=OneWay}"
                                                          VerticalAlignment="Center" Click="ToggleTheme_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWorkspaceVisible}"
                                              ToolTip.Tip="When a name is missing in the selected language, show its English translation when one exists. The original localisation source remains inspectable.">
                                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,12,0">
                                                <TextBlock Text="English fallback" FontWeight="SemiBold" />
                                                <TextBlock Text="Use English for names missing in the selected language."
                                                           Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding EnglishFallbackEnabled, Mode=OneWay}"
                                                          VerticalAlignment="Center" Click="EnglishFallback_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWorkspaceVisible}">
                                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,12,0">
                                                <TextBlock Text="Automatic refresh" FontWeight="SemiBold" />
                                                <TextBlock Text="Keep this workspace current when supported files change."
                                                           Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding AutomaticRefreshEnabled, Mode=OneWay}"
                                                          IsEnabled="{Binding IsAutomaticRefreshAvailable}"
                                                          VerticalAlignment="Center" Click="AutomaticRefresh_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="quiet" Content="Change workspace"
                            IsVisible="{Binding IsWorkspaceVisible}" Click="ChangeWorkspace_Click" />
                    <Button Classes="primary" Content="Reload"
                            IsVisible="{Binding IsWorkspaceVisible}" Click="Reload_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid IsVisible="{Binding IsWelcomeVisible}">
                <Border Classes="card" Width="660" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Open an Oxide workspace" FontSize="28" FontWeight="Bold" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Choose your Hearts of Iron IV installation and, optionally, the mod you are actively developing. Base-game content stays read-only; supported active-mod values can be previewed before saving." />
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <TextBlock Classes="label" Text="HEARTS OF IRON IV INSTALLATION" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding GameRootPath}" Watermark="Folder containing history, common and map" />
                                <Button Grid.Column="1" Classes="quiet" Content="Browse…" Click="BrowseGameRoot_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <TextBlock Classes="label" Text="ACTIVE MOD (OPTIONAL)" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding ActiveModRootPath}" Watermark="Your writable mod folder" />
                                <Button Grid.Column="1" Classes="quiet" Content="Browse…" Click="BrowseModRoot_Click" />
                                <Button Grid.Column="2" Classes="quiet" Content="Clear" Click="ClearModRoot_Click" />
                            </Grid>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                                       Text="Supported now: states, country tags and localisation syntax" />
                            <Button Grid.Column="1" Classes="primary" Content="Open workspace"
                                    IsEnabled="{Binding CanOpenWorkspace}" Click="OpenWorkspace_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsLoadingVisible}">
                <Border Classes="card" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Building your workspace" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{Binding LoadingMessage}" Classes="muted" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadingProgress}" Height="8" />
                        <Button Classes="quiet" HorizontalAlignment="Right" Content="Cancel" Click="CancelLoading_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsConceptWorkspaceVisible}" Margin="14" ColumnDefinitions="370,12,*">
                <Border Grid.Column="0" Classes="card" Padding="12">
                    <TabControl>
                        <TabItem Header="States">
                            <Grid Margin="0,10,0,0" RowDefinitions="Auto,Auto,*">
                                <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Search ID, name, owner, category or file…" />
                                <TextBlock Grid.Row="1" Margin="2,8" Classes="muted"
                                           Text="{Binding States.Count, StringFormat={}{0:N0} matching states}" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}"
                                         SelectionChanged="State_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StateListItemViewModel">
                                            <Grid ColumnDefinitions="58,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Column="0" Grid.RowSpan="2" Text="{Binding Id}"
                                                           Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Owner}" Classes="muted" FontSize="11" />
                                                    <TextBlock Text="•" Classes="muted" FontSize="11" />
                                                    <TextBlock Text="{Binding ProvinceSummary}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Countries">
                            <Grid Margin="0,10,0,0" RowDefinitions="Auto,Auto,*">
                                <TextBox Grid.Row="0" Text="{Binding CountrySearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Search country name, tag or source…" />
                                <TextBlock Grid.Row="1" Margin="2,8" Classes="muted"
                                           Text="{Binding Countries.Count, StringFormat={}{0:N0} matching countries}" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}"
                                         SelectionChanged="Country_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CountryListItemViewModel">
                                            <Grid ColumnDefinitions="58,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Column="0" Grid.RowSpan="2" Text="{Binding Tag}"
                                                           Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding NameStatus}"
                                                           Classes="muted" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Problems">
                            <Grid Margin="0,10,0,0" RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Margin="2,0,2,8" Classes="muted"
                                           Text="{Binding Problems.Count, StringFormat={}{0:N0} workspace problems}" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProblemListItemViewModel">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SeverityText}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" FontSize="11" />
                                                    <TextBlock Text="{Binding Code}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Location}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <Border Grid.Column="2" Classes="card">
                    <Grid>
                        <Grid IsVisible="{Binding IsStateDetailsVisible}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding HasNoSelectedState}">
                            <TextBlock Text="Select a state" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Classes="muted" Text="Choose a state to inspect semantic values and provenance." />
                        </StackPanel>
                        <Grid IsVisible="{Binding HasSelectedState}" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Padding="24,20" Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="10,10,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding SelectedState.DisplayName}" FontSize="26" FontWeight="Bold" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding SelectedState.Id, StringFormat=State {0}}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedState.LocalizationKey}" Classes="muted" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedState.Contribution.EffectiveLayerLabel}" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource OxideSurface}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedState.Status}" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TabControl Grid.Row="1" Margin="18">
                                <TabItem Header="Overview">
                                    <ScrollViewer Margin="4,16,4,4">
                                        <StackPanel Spacing="18">
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                                <Border Grid.Column="0" Classes="card" Padding="16">
                                                    <StackPanel Spacing="5"><TextBlock Classes="label" Text="OWNER" /><TextBlock Text="{Binding SelectedState.Owner}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Classes="card" Padding="16">
                                                    <StackPanel Spacing="5">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Classes="label" Text="CATEGORY" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Classes="quiet" Content="Edit" Padding="8,3"
                                                                    IsEnabled="{Binding CanEditSelectedStateCategory}"
                                                                    ToolTip.Tip="{Binding EditSelectedStateCategoryExplanation}"
                                                                    Click="EditStateCategory_Click"
                                                                    AutomationProperties.Name="Edit state category" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding SelectedState.Category}" FontSize="18" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SelectedStateCategoryEditHint}" Classes="muted" FontSize="10"
                                                                   TextWrapping="Wrap" MaxLines="2" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Classes="card" Padding="16">
                                                    <StackPanel Spacing="5">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Classes="label" Text="MANPOWER" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Classes="quiet" Content="Edit" Padding="8,3"
                                                                    IsEnabled="{Binding CanEditSelectedStateManpower}"
                                                                    ToolTip.Tip="{Binding EditSelectedStateManpowerExplanation}"
                                                                    Click="EditStateManpower_Click"
                                                                    AutomationProperties.Name="Edit state manpower" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding SelectedState.Manpower}" FontSize="18" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SelectedStateManpowerEditHint}" Classes="muted" FontSize="10"
                                                                   TextWrapping="Wrap" MaxLines="2" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Border Classes="card" Padding="18" IsVisible="{Binding IsStateEditOpen}">
                                                <StackPanel Spacing="14">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="3">
                                                            <TextBlock Text="{Binding StateEditTitle}" FontSize="19" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding StateEditSourcePath}" Classes="muted" FontSize="11"
                                                                       FontFamily="Menlo,Consolas,monospace" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="quiet" Content="Cancel" Click="CancelStateEdit_Click"
                                                                AutomationProperties.Name="Cancel state edit" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                        <StackPanel Grid.Column="0" Spacing="5">
                                                            <TextBlock Classes="label" Text="CURRENT VALUE" />
                                                            <TextBox Text="{Binding StateEditOriginalValue}" IsReadOnly="True" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="5">
                                                            <TextBlock Classes="label" Text="{Binding StateEditPropertyLabel}" />
                                                            <TextBox x:Name="StateEditValueTextBox"
                                                                     Text="{Binding StateEditDraftValue, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="New state value" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding StateEditValidationMessage}" Classes="muted" TextWrapping="Wrap" />
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                        <StackPanel Grid.Column="0" Spacing="5">
                                                            <TextBlock Classes="label" Text="BEFORE" />
                                                            <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="10">
                                                                <TextBlock Text="{Binding StateEditPreviewBefore}" FontFamily="Menlo,Consolas,monospace"
                                                                           FontSize="11" TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="5">
                                                            <TextBlock Classes="label" Text="AFTER" />
                                                            <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="10">
                                                                <TextBlock Text="{Binding StateEditPreviewAfter}" FontFamily="Menlo,Consolas,monospace"
                                                                           FontSize="11" TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Button Classes="primary" Content="Apply change" HorizontalAlignment="Right"
                                                            IsEnabled="{Binding CanApplyStateEdit}" Click="ApplyStateEdit_Click"
                                                            AutomationProperties.Name="Apply state edit" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="card" Padding="12" IsVisible="{Binding HasStateEditFeedback}"
                                                    BorderBrush="{DynamicResource OxideAccent}" BorderThickness="1">
                                                <TextBlock Text="{Binding StateEditFeedback}" TextWrapping="Wrap" />
                                            </Border>
                                            <Border Classes="card" Padding="16"><StackPanel Spacing="7"><TextBlock Classes="label" Text="CORES" /><TextBlock Text="{Binding SelectedState.Cores}" TextWrapping="Wrap" /></StackPanel></Border>
                                            <Border Classes="card" Padding="16"><StackPanel Spacing="7"><TextBlock Classes="label" Text="RESOURCES" /><TextBlock Text="{Binding SelectedState.Resources}" TextWrapping="Wrap" /></StackPanel></Border>
                                            <Border Classes="card" Padding="16">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <StackPanel Grid.Column="0" Spacing="5">
                                                        <TextBlock Classes="label" Text="STRATEGIC REGION" />
                                                        <TextBlock Text="{Binding SelectedState.StrategicRegion}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SelectedState.StrategicRegionSummary}" Classes="muted" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="12"
                                                            Padding="10,5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedState.StrategicRegionStatus}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Classes="card" Padding="16"><StackPanel Spacing="7"><TextBlock Classes="label" Text="PROVINCES" /><TextBlock Text="{Binding SelectedState.Provinces}" TextWrapping="Wrap" /></StackPanel></Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Source &amp; provenance">
                                    <ScrollViewer Margin="4,16,4,4">
                                        <StackPanel Spacing="16">
                                            <Border Classes="card" Padding="12">
                                                <Expander AutomationProperties.Name="State contribution details"
                                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                          Background="Transparent" BorderThickness="0">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                                            <TextBlock Grid.Row="0" Classes="label" Text="DECLARATION CONTRIBUTIONS" />
                                                            <Grid Grid.Row="1" ColumnDefinitions="Auto,10,*">
                                                                <TextBlock Grid.Column="0" Text="{Binding SelectedState.Contribution.EffectiveLayerLabel}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Text="·" Classes="muted" HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding SelectedState.Contribution.ResolutionReason}" Classes="muted"
                                                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding SelectedState.Contribution.ResolutionReason}" />
                                                            </Grid>
                                                            <Button Grid.Column="1" Grid.RowSpan="2" Classes="quiet" Content="Open source"
                                                                    IsVisible="{Binding SelectedState.Contribution.HasEffectiveSource}"
                                                                    Tag="{Binding SelectedState.Contribution.EffectiveNavigationRequest}"
                                                                    Click="OpenSource_Click" VerticalAlignment="Center"
                                                                    AutomationProperties.Name="Open effective state declaration source" />
                                                            <Border Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource OxideSurfaceRaised}"
                                                                    CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SelectedState.Contribution.ContributionCountLabel}" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel Margin="0,14,0,0" Spacing="10">
                                                    <ItemsControl ItemsSource="{Binding SelectedState.Contribution.Contributions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ContributionItemPresentation">
                                                                <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="12" Margin="0,0,0,8"
                                                                        AutomationProperties.Name="{Binding AccessibleName}">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                                        <StackPanel Grid.Column="0" Spacing="5">
                                                                            <TextBlock Text="{Binding DispositionLabel}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" />
                                                                            <Border IsVisible="{Binding IsEffective}" Background="{DynamicResource OxideAccent}" CornerRadius="8" Padding="7,2">
                                                                                <TextBlock Text="Selected" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Source.LayerName, StringFormat=Layer: {0}}" Classes="muted" />
                                                                            <TextBlock Text="{Binding Source.VirtualPath}" FontFamily="Menlo,Consolas,monospace" FontSize="10" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Source.Location}" Classes="muted" FontSize="10" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="2" Classes="quiet" Content="Open source"
                                                                                Tag="{Binding NavigationRequest}" Click="OpenSource_Click"
                                                                                AutomationProperties.Name="{Binding OpenSourceAccessibleName}" VerticalAlignment="Top" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl IsVisible="{Binding SelectedState.Contribution.HasComparisons}"
                                                                  ItemsSource="{Binding SelectedState.Contribution.Comparisons}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ContributionComparisonPresentation">
                                                                <Expander Margin="0,2,0,6" AutomationProperties.Name="{Binding AccessibleName}">
                                                                    <Expander.Header>
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock Text="{Binding ShadowedSummary, StringFormat=Compare with {0}}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11" />
                                                                        </StackPanel>
                                                                    </Expander.Header>
                                                                    <StackPanel Margin="0,10,0,0" Spacing="8">
                                                                    <Button Classes="quiet" Content="Open shadowed source" HorizontalAlignment="Left"
                                                                            Tag="{Binding ShadowedNavigationRequest}" Click="OpenSource_Click" />
                                                                    <ItemsControl ItemsSource="{Binding Fields}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:ContributionFieldComparisonPresentation">
                                                                                <Grid ColumnDefinitions="120,*,*,110" ColumnSpacing="10" Margin="0,0,0,7"
                                                                                      AutomationProperties.Name="{Binding AccessibleName}">
                                                                                    <TextBlock Grid.Column="0" Text="{Binding FieldName}" FontWeight="SemiBold" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding EffectiveValue}" TextWrapping="Wrap" />
                                                                                    <TextBlock Grid.Column="2" Text="{Binding ShadowedValue}" Classes="muted" TextWrapping="Wrap" />
                                                                                    <TextBlock Grid.Column="3" Text="{Binding DifferenceLabel}" Foreground="{DynamicResource OxideAccentSoft}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    </StackPanel>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <Border Grid.Column="0" Classes="card" Padding="18"><StackPanel Spacing="7"><TextBlock Classes="label" Text="CONTENT LAYER" /><TextBlock Text="{Binding SelectedState.SourceLayer}" /></StackPanel></Border>
                                                <Border Grid.Column="1" Classes="card" Padding="18"><StackPanel Spacing="7"><TextBlock Classes="label" Text="ENTITY PROBLEMS" /><TextBlock Text="{Binding SelectedState.DiagnosticCount}" /></StackPanel></Border>
                                            </Grid>
                                            <Border Classes="card" Padding="18">
                                                <StackPanel Spacing="7">
                                                    <TextBlock Classes="label" Text="HUMAN-READABLE NAME" />
                                                    <TextBlock Text="{Binding SelectedState.NameStatus}" />
                                                    <TextBlock Text="{Binding SelectedState.LocalisationSource}" TextWrapping="Wrap" FontFamily="Menlo,Consolas,monospace" />
                                                    <TextBlock Text="{Binding SelectedState.LocalisationLocation}" Classes="muted" />
                                                    <TextBlock Text="{Binding SelectedState.ResolvedLanguage, StringFormat=Language: {0}}" Classes="muted" />
                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,5,0,0">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Classes="label" Text="REQUESTED" />
                                                            <TextBlock Text="{Binding SelectedState.LocalisationInspection.RequestedLanguage}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Classes="label" Text="RESOLVED" />
                                                            <TextBlock Text="{Binding SelectedState.LocalisationInspection.ResolvedLanguage}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="2">
                                                            <TextBlock Classes="label" Text="FALLBACK" />
                                                            <TextBlock Text="{Binding SelectedState.LocalisationInspection.FallbackStatus}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Expander AutomationProperties.Name="State localisation resolution attempts"
                                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                              Background="Transparent" BorderThickness="0">
                                                        <Expander.Header>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="Resolution path" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding SelectedState.LocalisationInspection.SelectionReason}" Classes="muted" FontSize="11" />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel Margin="0,8,0,0" Spacing="8">
                                                        <ItemsControl ItemsSource="{Binding SelectedState.LocalisationInspection.ReferenceChain}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:LocalisationReferencePresentation">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,5"
                                                                          AutomationProperties.Name="{Binding AccessibleName}">
                                                                        <TextBlock Text="{Binding StepLabel}" FontWeight="SemiBold" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Contribution.EffectiveLayerLabel}" Classes="muted" FontSize="10" />
                                                                        <Button Grid.Column="3" Classes="quiet" Content="Open source" Padding="8,3"
                                                                                Tag="{Binding Contribution.EffectiveNavigationRequest}" Click="OpenSource_Click" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding SelectedState.LocalisationInspection.Attempts}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:LocalisationAttemptPresentation">
                                                                    <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="11" Margin="0,0,0,7"
                                                                            AutomationProperties.Name="{Binding AccessibleName}">
                                                                        <StackPanel Spacing="4">
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <TextBlock Text="{Binding StepLabel}" FontWeight="SemiBold" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Outcome}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="SemiBold" />
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding ResolutionReason}" Classes="muted" TextWrapping="Wrap" />
                                                                            <StackPanel IsVisible="{Binding HasContribution}" Spacing="3">
                                                                                <TextBlock Text="{Binding Contribution.EffectiveLayerLabel}" />
                                                                                <TextBlock Text="{Binding Contribution.ContributionCountLabel}" Classes="muted" />
                                                                                <ItemsControl ItemsSource="{Binding Contribution.Contributions}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="vm:ContributionItemPresentation">
                                                                                            <Grid ColumnDefinitions="95,*,Auto" ColumnSpacing="8" Margin="0,3,0,0">
                                                                                                <TextBlock Text="{Binding DispositionLabel}" FontWeight="SemiBold" />
                                                                                                <TextBlock Grid.Column="1" Text="{Binding Source.VirtualPath}" Classes="muted"
                                                                                                           FontFamily="Menlo,Consolas,monospace" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                                                <Button Grid.Column="2" Classes="quiet" Content="Open" Padding="8,3"
                                                                                                        Tag="{Binding NavigationRequest}" Click="OpenSource_Click" />
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="card" Padding="18">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Classes="label" Text="STRATEGIC-REGION MEMBERSHIP" />
                                                    <TextBlock Text="{Binding SelectedState.StrategicRegion}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedState.StrategicRegionStatus}" />
                                                    <TextBlock Text="{Binding SelectedState.StrategicRegionSummary}" Classes="muted" TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding SelectedState.StrategicRegionEvidence}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ProvinceRegionEvidenceViewModel">
                                                                <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="12" Margin="0,0,0,7">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{Binding ProvinceId, StringFormat=Province {0}}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource OxideAccentSoft}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding StateSource, StringFormat=State source: {0}}" Classes="muted"
                                                                                   FontFamily="Menlo,Consolas,monospace" FontSize="10" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding RegionSources, StringFormat=Region source: {0}}" Classes="muted"
                                                                                   FontFamily="Menlo,Consolas,monospace" FontSize="10" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Every value is derived from the source declaration above. Editing remains disabled in this first application slice." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                        </Grid>

                        <Grid IsVisible="{Binding IsCountryDetailsVisible}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                        IsVisible="{Binding HasNoSelectedCountry}">
                                <TextBlock Text="Select a country" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="Choose a country to inspect its name, states and provenance." />
                            </StackPanel>
                            <Grid IsVisible="{Binding HasSelectedCountry}" RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Padding="24,20" Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="10,10,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding SelectedCountry.DisplayName}" FontSize="26" FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding SelectedCountry.Tag}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedCountry.NameStatus}" Classes="muted" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedCountry.Contribution.EffectiveLayerLabel}" Classes="muted" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource OxideSurface}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedCountry.Status}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" Margin="22">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <Border Classes="card" Padding="16"><StackPanel Spacing="6"><TextBlock Classes="label" Text="DEFINITION PATH" /><TextBlock Text="{Binding SelectedCountry.DefinitionPath}" TextWrapping="Wrap" /></StackPanel></Border>
                                            <Border Grid.Column="1" Classes="card" Padding="16"><StackPanel Spacing="6"><TextBlock Classes="label" Text="DECLARATION SOURCE" /><TextBlock Text="{Binding SelectedCountry.DeclarationSummary}" TextWrapping="Wrap" /></StackPanel></Border>
                                        </Grid>
                                        <Border Classes="card" Padding="12">
                                            <Expander AutomationProperties.Name="Country contribution details"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      Background="Transparent" BorderThickness="0">
                                                <Expander.Header>
                                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                                        <TextBlock Grid.Row="0" Classes="label" Text="DECLARATION CONTRIBUTIONS" />
                                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,10,*">
                                                            <TextBlock Grid.Column="0" Text="{Binding SelectedCountry.Contribution.EffectiveLayerLabel}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="·" Classes="muted" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding SelectedCountry.Contribution.ResolutionReason}" Classes="muted"
                                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding SelectedCountry.Contribution.ResolutionReason}" />
                                                        </Grid>
                                                        <Button Grid.Column="1" Grid.RowSpan="2" Classes="quiet" Content="Open source"
                                                                IsVisible="{Binding SelectedCountry.Contribution.HasEffectiveSource}"
                                                                Tag="{Binding SelectedCountry.Contribution.EffectiveNavigationRequest}"
                                                                Click="OpenSource_Click" VerticalAlignment="Center"
                                                                AutomationProperties.Name="Open effective country declaration source" />
                                                        <Border Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource OxideSurfaceRaised}"
                                                                CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SelectedCountry.Contribution.ContributionCountLabel}" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Expander.Header>
                                                <StackPanel Margin="0,14,0,0" Spacing="10">
                                                <ItemsControl ItemsSource="{Binding SelectedCountry.Contribution.Contributions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ContributionItemPresentation">
                                                            <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="12" Margin="0,0,0,8"
                                                                    AutomationProperties.Name="{Binding AccessibleName}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                                    <StackPanel Grid.Column="0" Spacing="5">
                                                                        <TextBlock Text="{Binding DispositionLabel}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" />
                                                                        <Border IsVisible="{Binding IsEffective}" Background="{DynamicResource OxideAccent}" CornerRadius="8" Padding="7,2">
                                                                            <TextBlock Text="Selected" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Source.LayerName, StringFormat=Layer: {0}}" Classes="muted" />
                                                                        <TextBlock Text="{Binding Source.VirtualPath}" FontFamily="Menlo,Consolas,monospace" FontSize="10" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Source.Location}" Classes="muted" FontSize="10" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Classes="quiet" Content="Open source"
                                                                            Tag="{Binding NavigationRequest}" Click="OpenSource_Click"
                                                                            AutomationProperties.Name="{Binding OpenSourceAccessibleName}" VerticalAlignment="Top" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl IsVisible="{Binding SelectedCountry.Contribution.HasComparisons}"
                                                              ItemsSource="{Binding SelectedCountry.Contribution.Comparisons}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ContributionComparisonPresentation">
                                                            <Expander Margin="0,2,0,6" AutomationProperties.Name="{Binding AccessibleName}">
                                                                <Expander.Header>
                                                                    <StackPanel Spacing="3">
                                                                        <TextBlock Text="{Binding ShadowedSummary, StringFormat=Compare with {0}}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11" />
                                                                    </StackPanel>
                                                                </Expander.Header>
                                                                <StackPanel Margin="0,10,0,0" Spacing="8">
                                                                <Button Classes="quiet" Content="Open shadowed source" HorizontalAlignment="Left"
                                                                        Tag="{Binding ShadowedNavigationRequest}" Click="OpenSource_Click" />
                                                                <ItemsControl ItemsSource="{Binding Fields}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ContributionFieldComparisonPresentation">
                                                                            <Grid ColumnDefinitions="120,*,*,110" ColumnSpacing="10" Margin="0,0,0,7"
                                                                                  AutomationProperties.Name="{Binding AccessibleName}">
                                                                                <TextBlock Grid.Column="0" Text="{Binding FieldName}" FontWeight="SemiBold" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding EffectiveValue}" TextWrapping="Wrap" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding ShadowedValue}" Classes="muted" TextWrapping="Wrap" />
                                                                                <TextBlock Grid.Column="3" Text="{Binding DifferenceLabel}" Foreground="{DynamicResource OxideAccentSoft}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                </StackPanel>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                        <Border Classes="card" Padding="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="label" Text="OWNED STATES" />
                                                <ItemsControl ItemsSource="{Binding SelectedCountry.OwnedStateIds}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><Button Classes="quiet" Margin="0,0,6,6" Tag="{Binding}" Content="{Binding, StringFormat=State {0}}" Click="CountryState_Click" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding SelectedCountry.OwnedStates}" Classes="muted" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Padding="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="label" Text="CORE STATES" />
                                                <ItemsControl ItemsSource="{Binding SelectedCountry.CoreStateIds}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><Button Classes="quiet" Margin="0,0,6,6" Tag="{Binding}" Content="{Binding, StringFormat=State {0}}" Click="CountryState_Click" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding SelectedCountry.CoreStates}" Classes="muted" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Padding="16">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="label" Text="LOCALISATION PROVENANCE" />
                                                <TextBlock Text="{Binding SelectedCountry.LocalisationSource}" TextWrapping="Wrap" FontFamily="Menlo,Consolas,monospace" />
                                                <TextBlock Text="{Binding SelectedCountry.LocalisationLocation}" Classes="muted" />
                                                <TextBlock Text="{Binding SelectedCountry.ResolvedLanguage, StringFormat=Language: {0}}" Classes="muted" />
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,5,0,0">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="label" Text="REQUESTED" />
                                                        <TextBlock Text="{Binding SelectedCountry.LocalisationInspection.RequestedLanguage}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="label" Text="RESOLVED" />
                                                        <TextBlock Text="{Binding SelectedCountry.LocalisationInspection.ResolvedLanguage}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock Classes="label" Text="FALLBACK" />
                                                        <TextBlock Text="{Binding SelectedCountry.LocalisationInspection.FallbackStatus}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <Expander AutomationProperties.Name="Country localisation resolution attempts"
                                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                          Background="Transparent" BorderThickness="0">
                                                    <Expander.Header>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="Resolution path" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SelectedCountry.LocalisationInspection.SelectionReason}" Classes="muted" FontSize="11" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <StackPanel Margin="0,8,0,0" Spacing="8">
                                                    <ItemsControl ItemsSource="{Binding SelectedCountry.LocalisationInspection.ReferenceChain}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:LocalisationReferencePresentation">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,5"
                                                                      AutomationProperties.Name="{Binding AccessibleName}">
                                                                    <TextBlock Text="{Binding StepLabel}" FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Contribution.EffectiveLayerLabel}" Classes="muted" FontSize="10" />
                                                                    <Button Grid.Column="3" Classes="quiet" Content="Open source" Padding="8,3"
                                                                            Tag="{Binding Contribution.EffectiveNavigationRequest}" Click="OpenSource_Click" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding SelectedCountry.LocalisationInspection.Attempts}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:LocalisationAttemptPresentation">
                                                                <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="11" Margin="0,0,0,7"
                                                                        AutomationProperties.Name="{Binding AccessibleName}">
                                                                    <StackPanel Spacing="4">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Text="{Binding StepLabel}" FontWeight="SemiBold" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding Outcome}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="SemiBold" />
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding ResolutionReason}" Classes="muted" TextWrapping="Wrap" />
                                                                        <StackPanel IsVisible="{Binding HasContribution}" Spacing="3">
                                                                            <TextBlock Text="{Binding Contribution.EffectiveLayerLabel}" />
                                                                            <TextBlock Text="{Binding Contribution.ContributionCountLabel}" Classes="muted" />
                                                                            <ItemsControl ItemsSource="{Binding Contribution.Contributions}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:ContributionItemPresentation">
                                                                                        <Grid ColumnDefinitions="95,*,Auto" ColumnSpacing="8" Margin="0,3,0,0">
                                                                                            <TextBlock Text="{Binding DispositionLabel}" FontWeight="SemiBold" />
                                                                                            <TextBlock Grid.Column="1" Text="{Binding Source.VirtualPath}" Classes="muted"
                                                                                                       FontFamily="Menlo,Consolas,monospace" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                                            <Button Grid.Column="2" Classes="quiet" Content="Open" Padding="8,3"
                                                                                                    Tag="{Binding NavigationRequest}" Click="OpenSource_Click" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsSourceViewerVisible}" Margin="14" RowDefinitions="Auto,10,*">
                <Border Grid.Row="0" Classes="card" Padding="14">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                        <Button Grid.Column="0" Classes="quiet" Content="← Concept"
                                Click="CloseSourceViewer_Click" VerticalAlignment="Center"
                                AutomationProperties.Name="Return to concept view" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="quiet" Content="‹" IsEnabled="{Binding CanNavigateSourceBack}"
                                    Click="SourceHistoryBack_Click" AutomationProperties.Name="Previous source location"
                                    ToolTip.Tip="Previous source location (Option+Left)" />
                            <Button Classes="quiet" Content="›" IsEnabled="{Binding CanNavigateSourceForward}"
                                    Click="SourceHistoryForward_Click" AutomationProperties.Name="Next source location"
                                    ToolTip.Tip="Next source location (Option+Right)" />
                            <TextBlock Text="{Binding SourceHistorySummary}" Classes="muted" FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="{Binding SourceViewer.FileName}" FontSize="18" FontWeight="Bold" />
                                <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding SourceViewer.LayerName}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding SourceViewer.Participation}" Classes="muted" FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SourceViewer.VirtualPath}" Classes="muted"
                                       FontFamily="Menlo,Consolas,monospace" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding SourceViewer.PhysicalPath}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" Spacing="3">
                            <TextBlock Text="{Binding SourceViewer.LocationLabel}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SourceViewer.SnapshotLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,10,300" RowDefinitions="Auto,8,*">
                    <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Classes="card" Padding="10,8">
                        <Grid ColumnDefinitions="Auto,260,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Find" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox x:Name="SourceFindTextBox" Grid.Column="1"
                                     Text="{Binding SourceViewer.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Find in this file…" MaxLength="512"
                                     AutomationProperties.Name="Find in source file" />
                            <Button Grid.Column="2" Classes="quiet" Content="Previous" IsEnabled="{Binding SourceViewer.CanSearch}"
                                    Click="SourceFindPrevious_Click" AutomationProperties.Name="Previous source search result" />
                            <Button Grid.Column="3" Classes="quiet" Content="Next" IsEnabled="{Binding SourceViewer.CanSearch}"
                                    Click="SourceFindNext_Click" AutomationProperties.Name="Next source search result" />
                            <TextBlock Grid.Column="4" Text="{Binding SourceViewer.SearchSummary}" Classes="muted"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{Binding SourceViewer.WindowSummary}" Classes="muted"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Button Grid.Column="6" Classes="quiet" Content="Copy full file" Click="CopyFullSource_Click"
                                    AutomationProperties.Name="Copy complete source file" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="0" Grid.Row="2" Classes="card" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Padding="0" Background="{DynamicResource OxideSurface}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Background="{DynamicResource OxideSurfaceRaised}"
                                        BorderBrush="{DynamicResource OxideBorder}" BorderThickness="0,0,1,0" Padding="12,14">
                                    <TextBlock Text="{Binding SourceViewer.LineNumbers}" TextAlignment="Right"
                                               FontFamily="Menlo,Consolas,monospace" FontSize="12" LineHeight="19"
                                               Foreground="{DynamicResource OxideMuted}" />
                                </Border>
                                <SelectableTextBlock x:Name="SourceTextBlock" Grid.Column="1"
                                                     Text="{Binding SourceViewer.VisibleText}"
                                                     SelectionStart="{Binding SourceViewer.SelectionStart, Mode=OneWay}"
                                                     SelectionEnd="{Binding SourceViewer.SelectionEnd, Mode=OneWay}"
                                                     FontFamily="Menlo,Consolas,monospace" FontSize="12" LineHeight="19"
                                                     TextWrapping="NoWrap" Padding="14"
                                                     AutomationProperties.Name="Read-only snapshot source text" />
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Grid.Row="2" Classes="card" Padding="12">
                        <Grid RowDefinitions="Auto,8,*,Auto">
                            <StackPanel Grid.Row="0" Spacing="3">
                                <TextBlock Text="Source details" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding SourceViewer.SemanticIdentity}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="2">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="label" Text="NAVIGATION REASON" />
                                        <TextBlock Text="{Binding SourceViewer.Reason}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Classes="label" Text="DOCUMENT KIND" />
                                            <TextBlock Text="{Binding SourceViewer.DocumentKind}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Classes="label" Text="LAYER KIND" />
                                            <TextBlock Text="{Binding SourceViewer.LayerKind}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Classes="label" Text="ENCODING" />
                                            <TextBlock Text="{Binding SourceViewer.EncodingLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Classes="label" Text="NEWLINES" />
                                            <TextBlock Text="{Binding SourceViewer.NewlineLabel}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="6" IsVisible="{Binding SourceViewer.HasRelationships}">
                                        <TextBlock Text="{Binding SourceViewer.RelationshipSummary}" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding SourceViewer.Relationships}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SourceRelationshipViewModel">
                                                    <Button Classes="quiet" Tag="{Binding NavigationRequest}"
                                                            Click="OpenRelatedSource_Click"
                                                            IsEnabled="{Binding CanNavigate}"
                                                            AutomationProperties.Name="{Binding AccessibleName}"
                                                            HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource OxideAccentSoft}" />
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                                       Classes="muted" FontSize="10" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Spacing="6" IsVisible="{Binding SourceViewer.HasDiagnostics}">
                                        <TextBlock Text="{Binding SourceViewer.DiagnosticSummary}" FontWeight="SemiBold" />
                                        <ListBox ItemsSource="{Binding SourceViewer.Diagnostics}"
                                                 SelectedItem="{Binding SourceViewer.SelectedDiagnostic}"
                                                 SelectionChanged="SourceDiagnostic_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="navigation:SourceViewerDiagnostic">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Code}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource OxideAccentSoft}" />
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" />
                                                        <TextBlock Text="{Binding Line, StringFormat={}Line {0}}" Classes="muted" FontSize="10" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock Grid.Row="3" Text="Read-only snapshot source" Classes="muted" FontSize="10"
                                       HorizontalAlignment="Right" Margin="0,8,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource OxideSurface}" BorderBrush="{DynamicResource OxideBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                <TextBlock Grid.Column="0" Text="{Binding StatusSummary}" VerticalAlignment="Center" FontSize="11" Classes="muted" />
                <TextBlock Grid.Column="1" Text="{Binding SourceNavigationSummary}" IsVisible="{Binding HasSourceNavigationRequest}"
                           VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource OxideAccentSoft}"
                           MaxWidth="520" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceNavigationSummary}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsWorkspaceVisible}" ToolTip.Tip="{Binding AutomaticRefreshDetail}">
                    <ProgressBar Width="28" Height="3" IsIndeterminate="True" IsVisible="{Binding IsRefreshBusy}" />
                    <TextBlock Text="{Binding AutomaticRefreshSummary}" FontSize="11" Classes="muted"
                               Classes.attention="{Binding RefreshNeedsAttention}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="Safe active-mod editing" VerticalAlignment="Center" FontSize="11" Classes="muted" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="20" Padding="14,10" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{DynamicResource OxideErrorSurface}" CornerRadius="8" IsVisible="{Binding HasError}" ZIndex="10">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource OxideErrorText}"
                           TextWrapping="Wrap" MaxWidth="760" VerticalAlignment="Center" />
                <Button Classes="quiet" Content="Dismiss" Click="DismissError_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
