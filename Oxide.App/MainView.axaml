<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Oxide.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Oxide.App.MainView" x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800" MinWidth="980" MinHeight="640"
        Background="{DynamicResource OxideBackground}" Foreground="{DynamicResource OxideText}">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource OxideAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource OxideOnAccent}" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="{DynamicResource OxideSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource OxideText}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource OxideSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OxideBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource OxideText}" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource OxideSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OxideBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource OxideMuted}" /></Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource OxideMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="TabControl"><Setter Property="Background" Value="Transparent" /></Style>
    </Window.Styles>

    <Grid RowDefinitions="60,*,34">
        <Border Grid.Row="0" Background="{DynamicResource OxideSurface}" BorderBrush="{DynamicResource OxideBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0" ColumnDefinitions="Auto,18,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource OxideAccent}">
                        <TextBlock Text="O" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="18" Foreground="{DynamicResource OxideOnAccent}" />
                    </Border>
                    <TextBlock Text="Oxide" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding IsWorkspaceVisible}">
                    <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WorkspaceSummary}" Classes="muted" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Button Classes="quiet" Content="⚙  Settings">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Width="310" Padding="8">
                                    <StackPanel Spacing="18">
                                        <StackPanel Spacing="7" IsVisible="{Binding IsWorkspaceVisible}">
                                            <TextBlock Text="Localisation language" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                                      SelectedItem="{Binding SelectedLanguageOption, Mode=OneWay}"
                                                      DisplayMemberBinding="{Binding DisplayName}"
                                                      IsEnabled="{Binding HasAvailableLanguages}"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="Language_SelectionChanged" />
                                            <TextBlock Text="Choose which in-game translated names Oxide displays."
                                                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Dark mode" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkMode, Mode=OneWay}"
                                                          VerticalAlignment="Center" Click="ToggleTheme_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWorkspaceVisible}"
                                              ToolTip.Tip="When a name is missing in the selected language, show its English translation when one exists. The original localisation source remains inspectable.">
                                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,12,0">
                                                <TextBlock Text="English fallback" FontWeight="SemiBold" />
                                                <TextBlock Text="Use English for names missing in the selected language."
                                                           Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding EnglishFallbackEnabled, Mode=OneWay}"
                                                          VerticalAlignment="Center" Click="EnglishFallback_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="quiet" Content="Change workspace"
                            IsVisible="{Binding IsWorkspaceVisible}" Click="ChangeWorkspace_Click" />
                    <Button Classes="primary" Content="Reload"
                            IsVisible="{Binding IsWorkspaceVisible}" Click="Reload_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid IsVisible="{Binding IsWelcomeVisible}">
                <Border Classes="card" Width="660" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Open an Oxide workspace" FontSize="28" FontWeight="Bold" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Choose your Hearts of Iron IV installation and, optionally, the mod you are actively developing. Oxide builds a read-only semantic view without changing either folder." />
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <TextBlock Classes="label" Text="HEARTS OF IRON IV INSTALLATION" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding GameRootPath}" Watermark="Folder containing history, common and map" />
                                <Button Grid.Column="1" Classes="quiet" Content="Browse…" Click="BrowseGameRoot_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="7">
                            <TextBlock Classes="label" Text="ACTIVE MOD (OPTIONAL)" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding ActiveModRootPath}" Watermark="Your writable mod folder" />
                                <Button Grid.Column="1" Classes="quiet" Content="Browse…" Click="BrowseModRoot_Click" />
                                <Button Grid.Column="2" Classes="quiet" Content="Clear" Click="ClearModRoot_Click" />
                            </Grid>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                                       Text="Supported now: states, country tags and localisation syntax" />
                            <Button Grid.Column="1" Classes="primary" Content="Open workspace"
                                    IsEnabled="{Binding CanOpenWorkspace}" Click="OpenWorkspace_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsLoadingVisible}">
                <Border Classes="card" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Building your workspace" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{Binding LoadingMessage}" Classes="muted" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadingProgress}" Height="8" />
                        <Button Classes="quiet" HorizontalAlignment="Right" Content="Cancel" Click="CancelLoading_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsWorkspaceVisible}" Margin="14" ColumnDefinitions="370,12,*">
                <Border Grid.Column="0" Classes="card" Padding="12">
                    <TabControl>
                        <TabItem Header="States">
                            <Grid Margin="0,10,0,0" RowDefinitions="Auto,Auto,*">
                                <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Search ID, name, owner, category or file…" />
                                <TextBlock Grid.Row="1" Margin="2,8" Classes="muted"
                                           Text="{Binding States.Count, StringFormat={}{0:N0} matching states}" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}"
                                         SelectionChanged="State_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StateListItemViewModel">
                                            <Grid ColumnDefinitions="58,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Column="0" Grid.RowSpan="2" Text="{Binding Id}"
                                                           Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Owner}" Classes="muted" FontSize="11" />
                                                    <TextBlock Text="•" Classes="muted" FontSize="11" />
                                                    <TextBlock Text="{Binding ProvinceSummary}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Countries">
                            <Grid Margin="0,10,0,0" RowDefinitions="Auto,Auto,*">
                                <TextBox Grid.Row="0" Text="{Binding CountrySearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Search country name, tag or source…" />
                                <TextBlock Grid.Row="1" Margin="2,8" Classes="muted"
                                           Text="{Binding Countries.Count, StringFormat={}{0:N0} matching countries}" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}"
                                         SelectionChanged="Country_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CountryListItemViewModel">
                                            <Grid ColumnDefinitions="58,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Column="0" Grid.RowSpan="2" Text="{Binding Tag}"
                                                           Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding NameStatus}"
                                                           Classes="muted" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Problems">
                            <Grid Margin="0,10,0,0" RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Margin="2,0,2,8" Classes="muted"
                                           Text="{Binding Problems.Count, StringFormat={}{0:N0} workspace problems}" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProblemListItemViewModel">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SeverityText}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" FontSize="11" />
                                                    <TextBlock Text="{Binding Code}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Location}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <Border Grid.Column="2" Classes="card">
                    <Grid>
                        <Grid IsVisible="{Binding IsStateDetailsVisible}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding HasNoSelectedState}">
                            <TextBlock Text="Select a state" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Classes="muted" Text="Choose a state to inspect semantic values and provenance." />
                        </StackPanel>
                        <Grid IsVisible="{Binding HasSelectedState}" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Padding="24,20" Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="10,10,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding SelectedState.DisplayName}" FontSize="26" FontWeight="Bold" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding SelectedState.Id, StringFormat=State {0}}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedState.LocalizationKey}" Classes="muted" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedState.Contribution.EffectiveLayerLabel}" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource OxideSurface}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedState.Status}" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TabControl Grid.Row="1" Margin="18">
                                <TabItem Header="Overview">
                                    <ScrollViewer Margin="4,16,4,4">
                                        <StackPanel Spacing="18">
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                                <Border Grid.Column="0" Classes="card" Padding="16">
                                                    <StackPanel Spacing="5"><TextBlock Classes="label" Text="OWNER" /><TextBlock Text="{Binding SelectedState.Owner}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Classes="card" Padding="16">
                                                    <StackPanel Spacing="5"><TextBlock Classes="label" Text="CATEGORY" /><TextBlock Text="{Binding SelectedState.Category}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Classes="card" Padding="16">
                                                    <StackPanel Spacing="5"><TextBlock Classes="label" Text="MANPOWER" /><TextBlock Text="{Binding SelectedState.Manpower}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                                </Border>
                                            </Grid>
                                            <Border Classes="card" Padding="16"><StackPanel Spacing="7"><TextBlock Classes="label" Text="CORES" /><TextBlock Text="{Binding SelectedState.Cores}" TextWrapping="Wrap" /></StackPanel></Border>
                                            <Border Classes="card" Padding="16"><StackPanel Spacing="7"><TextBlock Classes="label" Text="RESOURCES" /><TextBlock Text="{Binding SelectedState.Resources}" TextWrapping="Wrap" /></StackPanel></Border>
                                            <Border Classes="card" Padding="16">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <StackPanel Grid.Column="0" Spacing="5">
                                                        <TextBlock Classes="label" Text="STRATEGIC REGION" />
                                                        <TextBlock Text="{Binding SelectedState.StrategicRegion}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SelectedState.StrategicRegionSummary}" Classes="muted" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="12"
                                                            Padding="10,5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedState.StrategicRegionStatus}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Classes="card" Padding="16"><StackPanel Spacing="7"><TextBlock Classes="label" Text="PROVINCES" /><TextBlock Text="{Binding SelectedState.Provinces}" TextWrapping="Wrap" /></StackPanel></Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Source &amp; provenance">
                                    <ScrollViewer Margin="4,16,4,4">
                                        <StackPanel Spacing="16">
                                            <Border Classes="card" Padding="12">
                                                <Expander AutomationProperties.Name="State contribution details"
                                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                          Background="Transparent" BorderThickness="0">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="3">
                                                            <TextBlock Grid.Row="0" Classes="label" Text="DECLARATION CONTRIBUTIONS" />
                                                            <Grid Grid.Row="1" ColumnDefinitions="Auto,10,*">
                                                                <TextBlock Grid.Column="0" Text="{Binding SelectedState.Contribution.EffectiveLayerLabel}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Text="·" Classes="muted" HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding SelectedState.Contribution.ResolutionReason}" Classes="muted"
                                                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding SelectedState.Contribution.ResolutionReason}" />
                                                            </Grid>
                                                            <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource OxideSurfaceRaised}"
                                                                    CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SelectedState.Contribution.ContributionCountLabel}" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel Margin="0,14,0,0" Spacing="10">
                                                    <ItemsControl ItemsSource="{Binding SelectedState.Contribution.Contributions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ContributionItemPresentation">
                                                                <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="12" Margin="0,0,0,8">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                        <StackPanel Grid.Column="0" Spacing="5">
                                                                            <TextBlock Text="{Binding DispositionLabel}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" />
                                                                            <Border IsVisible="{Binding IsEffective}" Background="{DynamicResource OxideAccent}" CornerRadius="8" Padding="7,2">
                                                                                <TextBlock Text="Selected" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Source.LayerName, StringFormat=Layer: {0}}" Classes="muted" />
                                                                            <TextBlock Text="{Binding Source.VirtualPath}" FontFamily="Menlo,Consolas,monospace" FontSize="10" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Source.Location}" Classes="muted" FontSize="10" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl IsVisible="{Binding SelectedState.Contribution.HasComparisons}"
                                                                  ItemsSource="{Binding SelectedState.Contribution.Comparisons}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ContributionComparisonPresentation">
                                                                <Expander Margin="0,2,0,6" AutomationProperties.Name="Compare effective and shadowed declarations">
                                                                    <Expander.Header>
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock Text="{Binding ShadowedSummary, StringFormat=Compare with {0}}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11" />
                                                                        </StackPanel>
                                                                    </Expander.Header>
                                                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Fields}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:ContributionFieldComparisonPresentation">
                                                                                <Grid ColumnDefinitions="120,*,*,110" ColumnSpacing="10" Margin="0,0,0,7">
                                                                                    <TextBlock Grid.Column="0" Text="{Binding FieldName}" FontWeight="SemiBold" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding EffectiveValue}" TextWrapping="Wrap" />
                                                                                    <TextBlock Grid.Column="2" Text="{Binding ShadowedValue}" Classes="muted" TextWrapping="Wrap" />
                                                                                    <TextBlock Grid.Column="3" Text="{Binding DifferenceLabel}" Foreground="{DynamicResource OxideAccentSoft}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <Border Grid.Column="0" Classes="card" Padding="18"><StackPanel Spacing="7"><TextBlock Classes="label" Text="CONTENT LAYER" /><TextBlock Text="{Binding SelectedState.SourceLayer}" /></StackPanel></Border>
                                                <Border Grid.Column="1" Classes="card" Padding="18"><StackPanel Spacing="7"><TextBlock Classes="label" Text="ENTITY PROBLEMS" /><TextBlock Text="{Binding SelectedState.DiagnosticCount}" /></StackPanel></Border>
                                            </Grid>
                                            <Border Classes="card" Padding="18">
                                                <StackPanel Spacing="7">
                                                    <TextBlock Classes="label" Text="HUMAN-READABLE NAME" />
                                                    <TextBlock Text="{Binding SelectedState.NameStatus}" />
                                                    <TextBlock Text="{Binding SelectedState.LocalisationSource}" TextWrapping="Wrap" FontFamily="Menlo,Consolas,monospace" />
                                                    <TextBlock Text="{Binding SelectedState.LocalisationLocation}" Classes="muted" />
                                                    <TextBlock Text="{Binding SelectedState.ResolvedLanguage, StringFormat=Language: {0}}" Classes="muted" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="card" Padding="18">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Classes="label" Text="STRATEGIC-REGION MEMBERSHIP" />
                                                    <TextBlock Text="{Binding SelectedState.StrategicRegion}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedState.StrategicRegionStatus}" />
                                                    <TextBlock Text="{Binding SelectedState.StrategicRegionSummary}" Classes="muted" TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding SelectedState.StrategicRegionEvidence}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ProvinceRegionEvidenceViewModel">
                                                                <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="12" Margin="0,0,0,7">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{Binding ProvinceId, StringFormat=Province {0}}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource OxideAccentSoft}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding StateSource, StringFormat=State source: {0}}" Classes="muted"
                                                                                   FontFamily="Menlo,Consolas,monospace" FontSize="10" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding RegionSources, StringFormat=Region source: {0}}" Classes="muted"
                                                                                   FontFamily="Menlo,Consolas,monospace" FontSize="10" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Every value is derived from the source declaration above. Editing remains disabled in this first application slice." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                        </Grid>

                        <Grid IsVisible="{Binding IsCountryDetailsVisible}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                        IsVisible="{Binding HasNoSelectedCountry}">
                                <TextBlock Text="Select a country" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="Choose a country to inspect its name, states and provenance." />
                            </StackPanel>
                            <Grid IsVisible="{Binding HasSelectedCountry}" RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Padding="24,20" Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="10,10,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding SelectedCountry.DisplayName}" FontSize="26" FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding SelectedCountry.Tag}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedCountry.NameStatus}" Classes="muted" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedCountry.Contribution.EffectiveLayerLabel}" Classes="muted" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource OxideSurface}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedCountry.Status}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" Margin="22">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <Border Classes="card" Padding="16"><StackPanel Spacing="6"><TextBlock Classes="label" Text="DEFINITION PATH" /><TextBlock Text="{Binding SelectedCountry.DefinitionPath}" TextWrapping="Wrap" /></StackPanel></Border>
                                            <Border Grid.Column="1" Classes="card" Padding="16"><StackPanel Spacing="6"><TextBlock Classes="label" Text="DECLARATION SOURCE" /><TextBlock Text="{Binding SelectedCountry.DeclarationSummary}" TextWrapping="Wrap" /></StackPanel></Border>
                                        </Grid>
                                        <Border Classes="card" Padding="12">
                                            <Expander AutomationProperties.Name="Country contribution details"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      Background="Transparent" BorderThickness="0">
                                                <Expander.Header>
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="3">
                                                        <TextBlock Grid.Row="0" Classes="label" Text="DECLARATION CONTRIBUTIONS" />
                                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,10,*">
                                                            <TextBlock Grid.Column="0" Text="{Binding SelectedCountry.Contribution.EffectiveLayerLabel}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="·" Classes="muted" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding SelectedCountry.Contribution.ResolutionReason}" Classes="muted"
                                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding SelectedCountry.Contribution.ResolutionReason}" />
                                                        </Grid>
                                                        <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource OxideSurfaceRaised}"
                                                                CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SelectedCountry.Contribution.ContributionCountLabel}" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Expander.Header>
                                                <StackPanel Margin="0,14,0,0" Spacing="10">
                                                <ItemsControl ItemsSource="{Binding SelectedCountry.Contribution.Contributions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ContributionItemPresentation">
                                                            <Border Background="{DynamicResource OxideSurfaceRaised}" CornerRadius="7" Padding="12" Margin="0,0,0,8">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                    <StackPanel Grid.Column="0" Spacing="5">
                                                                        <TextBlock Text="{Binding DispositionLabel}" Foreground="{DynamicResource OxideAccentSoft}" FontWeight="Bold" />
                                                                        <Border IsVisible="{Binding IsEffective}" Background="{DynamicResource OxideAccent}" CornerRadius="8" Padding="7,2">
                                                                            <TextBlock Text="Selected" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Source.LayerName, StringFormat=Layer: {0}}" Classes="muted" />
                                                                        <TextBlock Text="{Binding Source.VirtualPath}" FontFamily="Menlo,Consolas,monospace" FontSize="10" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Source.Location}" Classes="muted" FontSize="10" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl IsVisible="{Binding SelectedCountry.Contribution.HasComparisons}"
                                                              ItemsSource="{Binding SelectedCountry.Contribution.Comparisons}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ContributionComparisonPresentation">
                                                            <Expander Margin="0,2,0,6" AutomationProperties.Name="Compare effective and shadowed declarations">
                                                                <Expander.Header>
                                                                    <StackPanel Spacing="3">
                                                                        <TextBlock Text="{Binding ShadowedSummary, StringFormat=Compare with {0}}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11" />
                                                                    </StackPanel>
                                                                </Expander.Header>
                                                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Fields}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ContributionFieldComparisonPresentation">
                                                                            <Grid ColumnDefinitions="120,*,*,110" ColumnSpacing="10" Margin="0,0,0,7">
                                                                                <TextBlock Grid.Column="0" Text="{Binding FieldName}" FontWeight="SemiBold" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding EffectiveValue}" TextWrapping="Wrap" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding ShadowedValue}" Classes="muted" TextWrapping="Wrap" />
                                                                                <TextBlock Grid.Column="3" Text="{Binding DifferenceLabel}" Foreground="{DynamicResource OxideAccentSoft}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                        <Border Classes="card" Padding="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="label" Text="OWNED STATES" />
                                                <ItemsControl ItemsSource="{Binding SelectedCountry.OwnedStateIds}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><Button Classes="quiet" Margin="0,0,6,6" Tag="{Binding}" Content="{Binding, StringFormat=State {0}}" Click="CountryState_Click" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding SelectedCountry.OwnedStates}" Classes="muted" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Padding="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="label" Text="CORE STATES" />
                                                <ItemsControl ItemsSource="{Binding SelectedCountry.CoreStateIds}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><Button Classes="quiet" Margin="0,0,6,6" Tag="{Binding}" Content="{Binding, StringFormat=State {0}}" Click="CountryState_Click" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding SelectedCountry.CoreStates}" Classes="muted" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Padding="16">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="label" Text="LOCALISATION PROVENANCE" />
                                                <TextBlock Text="{Binding SelectedCountry.LocalisationSource}" TextWrapping="Wrap" FontFamily="Menlo,Consolas,monospace" />
                                                <TextBlock Text="{Binding SelectedCountry.LocalisationLocation}" Classes="muted" />
                                                <TextBlock Text="{Binding SelectedCountry.ResolvedLanguage, StringFormat=Language: {0}}" Classes="muted" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource OxideSurface}" BorderBrush="{DynamicResource OxideBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusSummary}" VerticalAlignment="Center" FontSize="11" Classes="muted" />
                <TextBlock Grid.Column="1" Text="Read-only semantic workspace" VerticalAlignment="Center" FontSize="11" Classes="muted" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="20" Padding="14,10" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{DynamicResource OxideErrorSurface}" CornerRadius="8" IsVisible="{Binding HasError}" ZIndex="10">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource OxideErrorText}"
                           TextWrapping="Wrap" MaxWidth="760" VerticalAlignment="Center" />
                <Button Classes="quiet" Content="Dismiss" Click="DismissError_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
